# Neon Postgres Database URL
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/social_scheduler?sslmode=require

# Supabase Auth & Database (Required for Supabase SSR)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Clerk Auth Keys (Required if using Clerk Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Google Gemini AI Studio API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash QStash Scheduler
QSTASH_URL=https://qstash.upstash.io/v2/publish
QSTASH_TOKEN=qstash_token_placeholder
QSTASH_CURRENT_SIGNING_KEY=sig_key_placeholder
QSTASH_NEXT_SIGNING_KEY=sig_key_next_placeholder
QSTASH_REGION=US_EAST_1

# Production Deployment URL
APP_URL=https://ai-social-media-scheduler.vercel.app

# Encryption Secret for API Keys (AES-256-GCM)
ENCRYPTION_SECRET=32_byte_secret_key_for_encrypting_user_gemini_keys_123

# Cloudflare R2 / S3 Compatible Storage
R2_ACCOUNT_ID=cloudflare_r2_account_id_placeholder
R2_ACCESS_KEY_ID=r2_access_key_placeholder
R2_SECRET_ACCESS_KEY=r2_secret_key_placeholder
R2_BUCKET_NAME=social-media-assets
R2_PUBLIC_DOMAIN=https://assets.yourdomain.com

# Plunk Email Notifications
PLUNK_API_KEY=plunk_secret_key_placeholder
