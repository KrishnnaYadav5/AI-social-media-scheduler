# ── Supabase All-in-One Configuration (Database, Auth, Storage) ─────────────

# 1. Supabase Relational Postgres Database URL
# (Get from Supabase Dashboard -> Project Settings -> Database -> Connection String)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. Supabase Auth & Storage API Keys
# (Get from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── AI & Scheduling Services ───────────────────────────────────────────────

# Google Gemini AI Studio API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Upstash QStash Automated Post Scheduler
QSTASH_URL=https://qstash.upstash.io/v2/publish
QSTASH_TOKEN=qstash_token_placeholder
QSTASH_CURRENT_SIGNING_KEY=sig_key_placeholder
QSTASH_NEXT_SIGNING_KEY=sig_key_next_placeholder
QSTASH_REGION=US_EAST_1

# Production App Deployment URL
APP_URL=https://ai-social-media-scheduler.vercel.app

# Encryption Secret for API Keys (AES-256-GCM)
ENCRYPTION_SECRET=32_byte_secret_key_for_encrypting_user_gemini_keys_123
